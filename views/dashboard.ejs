<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GeoAttend Pro | Institutional Intelligence Dashboard</title>

    <!-- External Assets -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&libraries=geometry"></script>

    <style>
        :root {
            --primary: #0D00A5;
            --primary-hover: #09007a;
            --primary-light: #F0F2FF;
            --secondary: #2B3674;
            --accent: #4318FF;
            --success: #05CD99;
            --danger: #EE5D50;
            --warning: #FFB547;
            --bg-body: #F4F7FE;
            --bg-card: #FFFFFF;
            --text-main: #1B2559;
            --text-muted: #A3AED0;
            --border: #E9EDF7;
            --shadow-sm: 0px 10px 30px rgba(112, 144, 176, 0.15);
            --shadow-lg: 0px 25px 50px -12px rgba(0, 0, 165, 0.2);
            --radius-xl: 30px;
            --radius-lg: 24px;
            --radius-md: 16px;
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body.dark-mode {
            --bg-body: #0B1437;
            --bg-card: #111C44;
            --text-main: #FFFFFF;
            --text-muted: #8F9BBA;
            --border: #1B2559;
            --primary-light: #1A2251;
            --shadow-sm: 0px 18px 40px rgba(0, 0, 0, 0.4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }

        body { background: var(--bg-body); color: var(--text-main); height: 100vh; overflow: hidden; display: flex; transition: var(--transition); }
        button, input, select, textarea { outline: none; transition: var(--transition); font-family: inherit; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 10px; }

        .card { background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border); padding: 28px; box-shadow: var(--shadow-sm); position: relative; overflow: hidden; transition: var(--transition); }
        .hidden { display: none !important; }

        /* Login */
        #login-screen { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%); }
        .login-card { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(30px); padding: 60px; border-radius: var(--radius-xl); width: 100%; max-width: 480px; border: 1px solid rgba(255,255,255,0.2); text-align: center; color: white; animation: fadeIn 0.8s ease; }
        .login-input { width: 100%; padding: 18px 24px; border-radius: 18px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.15); margin-bottom: 20px; color: white; }
        .login-btn { width: 100%; padding: 18px; border-radius: 18px; border: none; background: white; color: var(--primary); font-weight: 800; cursor: pointer; }
        .login-error { color: #FFB4B4; font-size: 0.85rem; margin-bottom: 15px; min-height: 18px; }

        /* Sidebar */
        aside { width: 300px; background: var(--bg-card); display: flex; flex-direction: column; padding: 40px 24px; border-right: 1px solid var(--border); z-index: 100; transition: var(--transition); }
        .nav-item { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-radius: 20px; color: var(--text-muted); font-weight: 700; cursor: pointer; margin-bottom: 8px; }
        .nav-item.active { background: var(--primary); color: white; box-shadow: 0px 12px 24px rgba(13, 0, 165, 0.25); }
        .weekday-chip { display:flex; align-items:center; gap:5px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 6px 10px; font-size: 0.75rem; font-weight: 700; cursor: pointer; }

        header { padding: 30px 45px; display: flex; justify-content: space-between; align-items: center; }
        .nav-tool-btn { width: 48px; height: 48px; border-radius: 16px; background: var(--bg-card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-main); }

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 30px; }
        .stat-card { background: var(--bg-card); padding: 25px; border-radius: var(--radius-lg); display: flex; align-items: center; gap: 20px; border: 1px solid var(--border); }
        .stat-icon { width: 64px; height: 64px; border-radius: 20px; display: flex; align-items: center; justify-content: center; background: var(--primary-light); color: var(--primary); }
        .stat-info span { font-size: 2rem; font-weight: 800; color: var(--text-main); display: block; line-height: 1; }
        .stat-info h4 { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; }

        .view { display: none; animation: slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        .view.active { display: block; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes scanning { 0% { top: 0; } 100% { top: 100%; } }

        /* Table UI */
        .table-container { background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border); overflow: hidden; }
        table { width: 100%; border-collapse: collapse; }
        th { background: var(--primary-light); padding: 20px 25px; text-align: left; font-size: 0.75rem; color: var(--primary); text-transform: uppercase; font-weight: 800; }
        td { padding: 20px 25px; border-bottom: 1px solid var(--border); font-size: 0.95rem; font-weight: 600; color: var(--text-main); }

        .badge { padding: 6px 14px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }
        .badge-success { background: #DCFCE7; color: var(--success); }
        .badge-danger { background: #FEE2E2; color: var(--danger); }
        .badge-warning { background: #FFF4E5; color: var(--warning); }
        .badge-info { background: #E0E7FF; color: #4338CA; }
        .badge-select { border: none; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; padding: 6px 10px; border-radius: 12px; cursor: pointer; }

        .geo-input { width: 100%; padding: 14px 18px; border-radius: 14px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main); margin-bottom: 15px; font-weight: 600; }
        .btn-primary { background: var(--primary); color: white; border: none; padding: 14px 28px; border-radius: 14px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; }

        /* Modal Overlay */
        .modal-overlay { position: fixed; inset: 0; background: rgba(11, 20, 55, 0.4); backdrop-filter: blur(10px); z-index: 5000; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: 0.4s; }
        .modal-overlay.open { opacity: 1; visibility: visible; }
        .modal-card { background: var(--bg-card); width: 100%; max-width: 500px; padding: 40px; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); transform: translateY(20px); transition: 0.4s; }

        #notif-drawer { position: fixed; top: 0; right: -420px; width: 400px; height: 100vh; background: var(--bg-card); box-shadow: -15px 0 40px rgba(0,0,0,0.1); z-index: 2000; transition: 0.4s; padding: 35px; border-left: 1px solid var(--border); }
        #notif-drawer.open { right: 0; }

        /* CRUD Specific Buttons */
        .btn-icon { width: 32px; height: 32px; border-radius: 8px; border: none; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; margin-right: 5px; }
        .btn-edit { background: var(--primary-light); color: var(--primary); }
        .btn-delete { background: #FEE2E2; color: var(--danger); }

        /* Toast */
        #toast-container { position: fixed; bottom: 30px; right: 30px; z-index: 9998; display: flex; flex-direction: column; gap: 10px; }
        .toast { padding: 16px 22px; border-radius: 14px; color: white; font-weight: 700; box-shadow: var(--shadow-sm); animation: fadeIn 0.3s ease; min-width: 260px; }
        .toast-success { background: var(--success); }
        .toast-error { background: var(--danger); }
        .toast-info { background: var(--primary); }

        /* ------------------------------------------------------------
           RESPONSIVE (mobile phones) — sidebar becomes a slide-in drawer,
           grids stack to one column, tables scroll horizontally instead
           of overflowing the viewport.
        ------------------------------------------------------------ */
        .mobile-nav-toggle { display: none; }

        @media (max-width: 900px) {
            body { overflow: auto; height: auto; min-height: 100vh; flex-direction: column; }

            .mobile-nav-toggle {
                display: flex; align-items: center; justify-content: center;
                width: 44px; height: 44px; border-radius: 14px; background: var(--bg-card);
                border: 1px solid var(--border); color: var(--text-main); cursor: pointer;
            }

            aside {
                position: fixed; inset: 0 25% 0 0; width: auto; max-width: 300px;
                transform: translateX(-105%); box-shadow: var(--shadow-lg); z-index: 3000;
            }
            aside.mobile-open { transform: translateX(0); }

            #main-wrapper { width: 100%; }
            header { padding: 20px; flex-wrap: wrap; gap: 12px; }
            header h2 { font-size: 1.3rem; }
            main { padding: 0 16px 30px !important; }

            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .stat-card { padding: 16px; gap: 12px; }
            .stat-icon { width: 46px; height: 46px; }
            .stat-info span { font-size: 1.3rem; }

            /* Any inline two/three/four-column grid collapses to one column on phones */
            [style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
            #geofence [style*="height: 720px"] { height: auto !important; }
            #geo-map { height: 320px; }

            .table-container { overflow-x: auto; }
            table { min-width: 640px; }

            .modal-card { max-width: calc(100vw - 32px); padding: 24px; max-height: 85vh; overflow-y: auto; }
            #notif-drawer { width: 85vw; right: -85vw; }

            .login-card { padding: 32px 24px; }
        }
    </style>
</head>
<body class="light-mode">

    <div id="toast-container"></div>

    <!-- NOTIFICATION DRAWER -->
    <div id="notif-drawer">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h3 style="font-weight: 800; font-size: 1.4rem;">Live Feed</h3>
            <button class="nav-tool-btn" onclick="G_App.ui.toggleNotifs()"><i data-lucide="x"></i></button>
        </div>
        <div id="notif-list">
            <div class="notif-item" style="padding: 18px; border-radius: 18px; background: var(--bg-body); border-left: 5px solid var(--primary); margin-bottom: 12px;">
                <h5>System Active</h5><p style="font-size: 0.85rem; color: var(--text-muted);">Admin interface established.</p>
            </div>
        </div>
    </div>

    <!-- MODAL PARA SA CRUD (CREATE/EDIT) -->
    <div id="crud-modal" class="modal-overlay">
        <div class="modal-card">
            <h2 id="modal-title" style="margin-bottom: 25px; font-weight: 800;">Register Member</h2>
            <input type="hidden" id="inp-id">
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Employee ID *</label>
            <input type="text" id="inp-code" class="geo-input" placeholder="e.g. E004" required>
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Surname *</label>
            <input type="text" id="inp-surname" class="geo-input" placeholder="Surname" required>
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Given Name *</label>
            <input type="text" id="inp-given-name" class="geo-input" placeholder="Given Name" required>
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Middle Name</label>
            <input type="text" id="inp-middle-name" class="geo-input" placeholder="Middle Name (optional)">
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Suffix</label>
            <select id="inp-suffix" class="geo-input">
                <option value="">None</option>
                <option value="Jr.">Jr.</option>
                <option value="Sr.">Sr.</option>
                <option value="II">II</option>
                <option value="III">III</option>
                <option value="IV">IV</option>
                <option value="V">V</option>
            </select>
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 5px;">
                <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; display: block;">Department *</label>
                <a href="javascript:void(0)" style="font-size: 0.7rem; font-weight: 800; color: var(--primary);" onclick="G_App.departments.openModal()">+ Add New</a>
            </div>
            <select id="inp-dept" class="geo-input"></select>
            <input type="text" id="inp-position" class="geo-input" placeholder="Job Position (e.g. Dean, Instructor)">
            <input type="email" id="inp-email" class="geo-input" placeholder="Email Address">
            <select id="inp-status" class="geo-input">
                <option value="Full-time">Full-time</option>
                <option value="Part-time">Part-time</option>
                <option value="COS">COS (Contract of Service)</option>
                <option value="Inactive">Inactive</option>
            </select>
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Classification</label>
            <select id="inp-classification" class="geo-input">
                <option value="Regular">Regular</option>
                <option value="COS">COS</option>
                <option value="Casual">Casual</option>
            </select>
            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Remark</label>
            <select id="inp-remark" class="geo-input">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="Leave">Leave</option>
            </select>
            <div style="display: flex; gap: 15px; margin-top: 10px;">
                <button class="btn-primary" style="background: var(--border); color: var(--text-main); flex: 1;" onclick="G_App.employees.closeModal()">Cancel</button>
                <button class="btn-primary" style="flex: 2;" id="btn-save-member" onclick="G_App.employees.save()">Save Member</button>
            </div>
        </div>
    </div>

    <!-- LOGIN -->
    <div id="login-screen">
        <div class="login-card">
            <div style="margin: 0 auto 30px; background: white; color: var(--primary); width: 70px; height: 70px; border-radius: 22px; display: flex; align-items: center; justify-content: center;"><i data-lucide="shield-check" size="36"></i></div>
            <h1 style="font-size: 1.8rem; font-weight: 800;">GeoAttend Pro</h1>
            <p style="margin-bottom: 30px; opacity: 0.7;">Institutional Intelligence Gateway</p>
            <div class="login-error" id="login-error"></div>
            <input type="email" id="login-email" class="login-input" placeholder="Admin Email" value="<%= typeof defaultAdminEmail !== 'undefined' ? defaultAdminEmail : 'admin@geoattend.pro' %>">
            <input type="password" id="login-password" class="login-input" placeholder="Password" onkeypress="if(event.key==='Enter') G_App.auth.login()">
            <button class="login-btn" id="login-btn" onclick="G_App.auth.login()">Verify & Authorize</button>
        </div>
    </div>

    <!-- SIDEBAR -->
    <aside id="app-sidebar" class="hidden">
        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 50px;">
            <div style="background: var(--primary); color: white; padding: 10px; border-radius: 14px;"><i data-lucide="globe"></i></div>
            <h1 style="font-size: 1.4rem; font-weight: 800; color: var(--primary);">GeoAttend</h1>
        </div>
        <nav style="flex: 1;">
            <div class="nav-item active" data-target="dashboard"><i data-lucide="layout-dashboard"></i> Dashboard</div>
            <div class="nav-item" data-target="employees"><i data-lucide="users-2"></i> Employees</div>
            <div class="nav-item" data-target="departments"><i data-lucide="building-2"></i> Departments</div>
            <div class="nav-item" data-target="attendance"><i data-lucide="calendar-check"></i> Attendance</div>
            <div class="nav-item" data-target="events"><i data-lucide="calendar-range"></i> Events</div>
            <div class="nav-item" data-target="reports"><i data-lucide="file-bar-chart"></i> Reports</div>
            <div class="nav-item" data-target="geofence"><i data-lucide="map-pin"></i> Geo-Fences</div>
            <div class="nav-item" data-target="ocr-section"><i data-lucide="fingerprint"></i> OCR Verification</div>
            <div class="nav-item" data-target="ratings"><i data-lucide="trophy"></i> Ratings</div>
            <div class="nav-item" data-target="mobile-app"><i data-lucide="smartphone"></i> Device Management</div>
            <div class="nav-item" data-target="settings"><i data-lucide="sliders"></i> Settings</div>
        </nav>
        <div class="nav-item" style="color: var(--danger); background: #FFF1F0; margin-top: 20px;" onclick="G_App.auth.logout()"><i data-lucide="power"></i> Terminate</div>
    </aside>

    <!-- MAIN WRAPPER -->
    <div id="main-wrapper" class="hidden" style="flex: 1; flex-direction: column; overflow: hidden;">
        <header>
            <div style="display:flex; align-items:center; gap:16px;">
                <div class="mobile-nav-toggle" onclick="G_App.ui.toggleMobileNav()"><i data-lucide="menu"></i></div>
                <div><h2 id="view-title" style="font-weight: 800; font-size: 1.8rem;">Dashboard</h2><p id="view-subtitle" style="color: var(--text-muted); font-size: 0.95rem;">System Overview</p></div>
            </div>
            <div style="display: flex; gap: 18px; align-items: center;">
                <div class="nav-tool-btn" onclick="G_App.ui.toggleDarkMode()"><i data-lucide="sun"></i></div>
                <div class="nav-tool-btn" onclick="G_App.ui.toggleNotifs()"><i data-lucide="bell"></i></div>
                <div class="card" id="admin-name-badge" style="padding: 12px 24px; font-weight: 800; color: var(--primary); background: var(--primary-light); border: none;">Super Admin</div>
            </div>
        </header>

        <main style="padding: 0 45px 45px; overflow-y: auto; flex: 1;">

            <!-- DASHBOARD -->
            <div id="dashboard" class="view active">
                <div class="stats-grid">
                    <div class="stat-card"><div class="stat-icon"><i data-lucide="users"></i></div><div class="stat-info"><h4>Total</h4><span id="stat-total">--</span></div></div>
                    <div class="stat-card"><div class="stat-icon" style="color:var(--success)"><i data-lucide="check-circle-2"></i></div><div class="stat-info"><h4>Full-Time</h4><span id="stat-present">--</span></div></div>
                    <div class="stat-card"><div class="stat-icon" style="color:var(--warning)"><i data-lucide="timer"></i></div><div class="stat-info"><h4>Part-Time</h4><span id="stat-late">--</span></div></div>
                    <div class="stat-card"><div class="stat-icon" style="color:var(--danger)"><i data-lucide="user-x"></i></div><div class="stat-info"><h4>Inactive</h4><span id="stat-absent">--</span></div></div>
                </div>
                <div style="display: grid; grid-template-columns: 1.8fr 1fr; gap: 30px; margin-top: 30px;">
                    <div class="card">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom: 10px;">
                            <h3 style="margin:0;">Department Attendance — Total vs. Attended</h3>
                            <div style="display:flex; gap:8px;">
                                <select id="dash-dept-event" class="geo-input" style="margin:0; width:auto; font-size:0.8rem;" onchange="G_App.ui.loadDepartmentAttendanceChart()">
                                    <option value="">All Events</option>
                                </select>
                                <select id="dash-dept-classification" class="geo-input" style="margin:0; width:auto; font-size:0.8rem;" onchange="G_App.ui.loadDepartmentAttendanceChart()">
                                    <option value="all">All Classifications</option>
                                    <option value="Regular">Regular</option>
                                    <option value="COS">COS</option>
                                    <option value="Casual">Casual</option>
                                </select>
                            </div>
                        </div>
                        <canvas id="deptAttendanceChart" height="130"></canvas>
                    </div>
                    <div class="card">
                        <h3>Employee Classification</h3>
                        <canvas id="classificationChart" height="150"></canvas>
                    </div>
                </div>
            </div>

            <!-- EMPLOYEES -->
            <div id="employees" class="view">
                <div class="card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
                        <div style="display: flex; gap: 15px; flex: 1; min-width: 260px;">
                            <input type="text" placeholder="Search resources..." class="geo-input" style="max-width: 350px; margin: 0;" onkeyup="G_App.employees.filter(this.value)">
                            <select id="filter-dept" class="geo-input" style="max-width: 250px; margin: 0;" onchange="G_App.employees.render()">
                                <option value="all">All Departments</option>
                            </select>
                            <select id="filter-classification" class="geo-input" style="max-width: 200px; margin: 0;" onchange="G_App.employees.render()">
                                <option value="all">All Classifications</option>
                                <option value="Regular">Regular</option>
                                <option value="COS">COS</option>
                                <option value="Casual">Casual</option>
                            </select>
                        </div>
                        <div style="display:flex; gap:10px; flex-wrap: wrap;">
                            <button class="btn-primary" style="background: var(--success);" onclick="G_App.employees.exportFile('csv')"><i data-lucide="download"></i> CSV</button>
                            <button class="btn-primary" style="background: var(--secondary);" onclick="G_App.employees.exportFile('excel')"><i data-lucide="download"></i> Excel</button>
                            <button class="btn-primary" style="background: var(--warning);" onclick="G_App.employeeImport.openModal()"><i data-lucide="upload"></i> Batch Import</button>
                            <button class="btn-primary" onclick="G_App.employees.openModal()"><i data-lucide="user-plus"></i> Add New Employee</button>
                        </div>
                    </div>
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Employee ID</th>
                                    <th>Department/Office</th>
                                    <th>Position</th>
                                    <th>Classification</th>
                                    <th>Status</th>
                                    <th>Remark</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="employee-table-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODAL: BATCH IMPORT EMPLOYEES -->
            <div id="import-modal" class="modal-overlay">
                <div class="modal-card" style="max-width: 780px; width: 92vw;">
                    <h2 style="margin-bottom: 10px; font-weight: 800;">Batch Import Employees</h2>
