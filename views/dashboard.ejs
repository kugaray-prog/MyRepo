                                <input type="datetime-local" id="gf-end" class="geo-input">
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div>
                                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Latitude</label>
                                    <input type="number" step="any" id="gf-lat" class="geo-input" placeholder="e.g. 13.6218" oninput="G_App.geofence.onCoordInput()">
                                </div>
                                <div>
                                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Longitude</label>
                                    <input type="number" step="any" id="gf-lng" class="geo-input" placeholder="e.g. 123.1948" oninput="G_App.geofence.onCoordInput()">
                                </div>
                            </div>
                            <div style="display:flex; gap: 8px; margin-bottom: 15px;">
                                <button type="button" class="btn-primary" style="flex:1; padding: 10px; font-size: 0.8rem; background: var(--secondary, #4318FF);" onclick="G_App.geofence.previewCoords()"><i data-lucide="map-pin" size="14"></i> Preview on Map</button>
                                <button type="button" class="btn-primary" style="flex:1; padding: 10px; font-size: 0.8rem; background: var(--text-muted);" onclick="G_App.geofence.useMyLocation()"><i data-lucide="locate-fixed" size="14"></i> Use My Location</button>
                            </div>
                            <button type="button" class="btn-primary" style="width:100%; margin-bottom: 15px; padding: 10px; font-size: 0.8rem; background: var(--warning);" onclick="G_App.geofence.useCspcDefault()"><i data-lucide="school" size="14"></i> Use CSPC Default Location</button>
                            <p style="font-size: 0.7rem; color: var(--text-muted); margin: -10px 0 15px;">Type exact coordinates, or click the map to auto-fill this field while drawing the boundary below.</p>

                            <div style="background: var(--bg-body); border-radius: 16px; padding: 16px; margin-bottom: 15px;">
                                <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display:block;">Recurring Schedule</label>
                                <select id="gf-recurrence-type" class="geo-input" style="margin-bottom:10px;" onchange="G_App.geofence.onRecurrenceTypeChange()">
                                    <option value="none">One-time event</option>
                                    <option value="weekly">Every selected weekday(s)</option>
                                </select>
                                <div id="gf-recurrence-fields" class="hidden">
                                    <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px;" id="gf-weekday-picker">
                                        <label class="weekday-chip"><input type="checkbox" value="1"> Mon</label>
                                        <label class="weekday-chip"><input type="checkbox" value="2"> Tue</label>
                                        <label class="weekday-chip"><input type="checkbox" value="3"> Wed</label>
                                        <label class="weekday-chip"><input type="checkbox" value="4"> Thu</label>
                                        <label class="weekday-chip"><input type="checkbox" value="5"> Fri</label>
                                        <label class="weekday-chip"><input type="checkbox" value="6"> Sat</label>
                                        <label class="weekday-chip"><input type="checkbox" value="7"> Sun</label>
                                    </div>
                                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display:block;">Repeat Until</label>
                                    <input type="date" id="gf-recurrence-end" class="geo-input">
                                </div>
                            </div>

                            <div style="background: var(--bg-body); border-radius: 16px; padding: 16px; margin-bottom: 15px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase;">Boundary Polygon</label>
                                    <span id="gf-point-count" style="font-size: 0.75rem; font-weight: 800; color: var(--primary);">0 points</span>
                                </div>
                                <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 12px;">Click the map to place each corner of the geofence boundary, in order, then close the shape. At least 3 points are required.</p>
                                <div style="display:flex; gap: 8px;">
                                    <button type="button" class="btn-primary" style="flex:1; padding: 10px; font-size: 0.8rem; background: var(--warning);" onclick="G_App.geofence.undoPoint()"><i data-lucide="undo-2" size="14"></i> Undo Point</button>
                                    <button type="button" class="btn-primary" style="flex:1; padding: 10px; font-size: 0.8rem; background: var(--danger);" onclick="G_App.geofence.clearPoints()"><i data-lucide="x-circle" size="14"></i> Clear</button>
                                </div>
                            </div>


                            <div style="display: flex; gap: 10px;">
