                            <input type="text" id="gf-title" class="geo-input" placeholder="e.g. Annual Tech Symposium">
                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px;">Venue Name</label>
                            <input type="text" id="gf-venue" class="geo-input" placeholder="e.g. Grand Ballroom A">
                            <div>
                                <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;"></label>
                                <input type="datetime-local" id="gf-start" class="geo-input">
                            </div>
